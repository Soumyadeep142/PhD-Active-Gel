Cell[CellGroupData[{

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"a", "=", 
    RowBox[{"-", "1"}]}], ";"}], "Input"], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"v", "[", "x_", "]"}], " ", ":=", 
    RowBox[{
     RowBox[{"-", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "a"}], ")"}]}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "0.5"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "a"}], ")"}], "^", "2"}]}], "]"}]}]}], ";"}], 
  "Input"], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"l", "=", "1"}], ";"}], "Input"], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"\[Tau]", "=", "1"}], ";"}], "Input"], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"\[Beta]", "=", "10"}], ";"}], "Input"], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   StyleBox[
    RowBox[{
     StyleBox["o", "Input"], "de"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"l", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"Q", "''"}], "[", "x", "]"}]}], "-", 
     RowBox[{"\[Tau]", " ", 
      RowBox[{"v", "[", "x", "]"}], " ", 
      RowBox[{
       RowBox[{"Q", "'"}], "[", "x", "]"}]}], "-", 
     RowBox[{"Q", "[", "x", "]"}]}], "\[Equal]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Beta]", "*", " ", 
       RowBox[{"\[Tau]", "/", "2"}]}], ")"}], " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"v", "[", "x", "]"}], ",", "x"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ode", ",", 
        RowBox[{
         RowBox[{"Q", "[", 
          RowBox[{"-", "10"}], "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{"Q", "[", "10", "]"}], "\[Equal]", "0"}]}], "}"}], ",", "Q", 
      ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Dsolve", "[", 
    RowBox[{"ode", ",", " ", 
     RowBox[{"Q", "[", "x", "]"}], ",", " ", "x"}], "]"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Q", "'"}], "[", "x", "]"}], "/.", "sol"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", " ", 
      RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
      RowBox[{"AxesLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", "\"\<Q'(x)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "\[Rule]", "\"\<Numerical Solution Q'(x)\>\""}]}], 
     "]"}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Qprime", "[", "x_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", "'"}], "[", "x", "]"}], "/.", 
     RowBox[{"First", "[", "sol", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Qprime", "[", "x", "]"}], ",", 
      RowBox[{
       RowBox[{"-", "1"}], "\[LessEqual]", "x", "\[LessEqual]", "1"}]}], 
     "}"}], ",", "x"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"plt", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"v", "[", "x", "]"}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"Q", "[", "x", "]"}], "/.", 
        RowBox[{"First", "[", "sol", "]"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "5", ",", 
      RowBox[{"-", "5"}]}], "}"}], ",", 
    RowBox[{"ScalingFunctions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Reverse\>\"", ",", "None"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<v(x)\>\"", ",", "\"\<Q(x)\>\""}], "}"}], ",", "Above"}], 
      "]"}]}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Red", ",", " ", 
         RowBox[{"Thickness", "[", "0.005", "]"}], ",", " ", "Dashed"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", " ", 
         RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"AxesOrigin", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<Value\>\""}], "}"}]}], ",", " ", 
    RowBox[{"ImageSize", "\[Rule]", "700"}], ",", "  ", 
    RowBox[{"FrameStyle", "\[Rule]", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", 
       RowBox[{"Thickness", "[", "0.005", "]"}]}], "]"}]}], ",", " ", 
    RowBox[{"LabelStyle", "\[Rule]", "25"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
